# Copie este arquivo para .env e preencha os valores
# cp .env.example .env

# Ambiente: dev | prod
DJANGO_ENV=dev
DJANGO_SECRET_KEY=troque-por-uma-chave-segura
DJANGO_DEBUG=True

# Banco de dados local (dev) — MySQL via Docker ou instalação local
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ecommerce_dev
DB_USER=root
DB_PASSWORD=root

# Variáveis usadas apenas em produção (Elastic Beanstalk injeta automaticamente)
# RDS_HOSTNAME=
# RDS_DB_NAME=
# RDS_USERNAME=
# RDS_PASSWORD=
# RDS_PORT=3306

# S3 — necessário apenas em produção
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=us-east-1
